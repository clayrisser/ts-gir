{
  "name": "ts-gir",
  "version": "0.3.0",
  "description": "generate typescript from gir",
  "keywords": [
    "generate",
    "gir",
    "gobject",
    "introspect",
    "introspection",
    "ts",
    "ts-gir",
    "typescript"
  ],
  "homepage": "https://gitlab.com/bitspur/misc/ts-gir",
  "bugs": {
    "url": "https://gitlab.com/bitspur/misc/ts-gir/-/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Clay Risser",
    "email": "clayrisser@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/bitspur/misc/ts-gir.git"
  },
  "bin": {
    "ts-gir": "bin/bin.js"
  },
  "files": [
    "lib",
    "bin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf lib coverage *.tsbuildinfo",
    "format": "oxfmt .",
    "lint": "oxlint && tsc --noEmit",
    "test": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov"
  },
  "dependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/template": "^8.0.0",
    "@babel/types": "^8.0.4",
    "commander": "^15.0.0",
    "cosmiconfig": "^10.0.0",
    "fast-xml-parser": "^5.10.1",
    "glob": "^13.0.6",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.22.0",
  "tsgir": {
    "importMap": {},
    "dir": "@types"
  }
}
